# ============================================================
# +BET — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais no Git.
# ============================================================

# --- Supabase ---
# Encontre em: Project Settings > API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sua_anon_key_aqui

# Apenas server-side (nunca expor ao cliente)
SUPABASE_SECRET_KEY=sua_secret_key_aqui

# --- Football-Data.org ---
# Encontre em: https://www.football-data.org/client/login → My Account → API Keys
FOOTBALL_DATA_KEY=sua_chave_aqui

# --- Cron Security ---
# String aleatória para proteger as rotas de sync (cron jobs)
# Gere com: openssl rand -hex 32
CRON_SECRET=gere_uma_string_secreta_aleatoria


# --- Configuração do Campeonato ---
# ID do Brasileirão Série A na API-Sports (fixo: 71)
NUXT_PUBLIC_BRASILEIRAO_LEAGUE_ID=71
NUXT_PUBLIC_BRASILEIRAO_SEASON=2025
